    "if first_frame is not None and labels is not None:\n",
    "    # Get middle Z slice\n",
    "    z_middle = first_frame.shape[0] // 2\n",
    "    img_slice = first_frame[z_middle, :, :]\n",
    "    label_slice = labels[z_middle, :, :]\n",
    "    \n",
    "    fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n",
    "    \n",
